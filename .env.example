# JobsFind Configuration Template
# Copy this file to .env to override default application settings

# Path to Candidate Resume Profile JSON
JOBSFIND_PROFILE_PATH=resume_profile.json

# Path to SQLite Applications Database
JOBSFIND_DB_PATH=job_applications.db

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
JOBSFIND_LOG_LEVEL=INFO

# HTTP Network Timeout (seconds)
JOBSFIND_HTTP_TIMEOUT=5

# Maximum Retries for Remote HTTP Requests
JOBSFIND_MAX_RETRIES=3

# Live Remote Job API URL
JOBSFIND_JOBICY_API_URL=https://jobicy.com/api/v2/remote-jobs
